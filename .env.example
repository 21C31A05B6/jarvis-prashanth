# Copy this file to .env and fill in your values locally.
# Never commit .env to GitHub.

# Required for Google Gemini Live
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional: choose from SUPPORTED_VOICE_NAMES in main.py (case-insensitive)
# Example: puck, charon, kore, fenrir, aoede, leda, orus, schedar, zubenelgenubi
GEMINI_VOICE_NAME="puck"

# Optional Gmail Desktop OAuth client JSON. Gmail uses browser OAuth, never an API key.
#GMAIL_OAUTH_CLIENT_FILE="/absolute/path/to/client_secret_....json"

# Optional presentation model overrides
#PRESENTATION_QA_MODEL="gemini-2.5-flash"
#GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Optional: trial/keyword runtime limit
# If JARVIS_TRIAL_KEYWORD is set to any non-empty string,
# Jarvis will run for JARVIS_RUNTIME_SECONDS (default: 3600).
#JARVIS_TRIAL_KEYWORD="trial"
#JARVIS_RUNTIME_SECONDS="3600"

# Optional: locked container requirements
#JARVIS_LOCKED_KEY_SECRET="expected_unlock_key_contents"
#JARVIS_LOCKED_VOLUME="NameOfVolumeUnderVolumes"

# Optional: for the local API (if you enable api.server)
#JARVIS_API_KEY="YOUR_PRIVATE_API_KEY"

# Hosted API (FastAPI + Postgres + Redis)
#DATABASE_URL="postgresql://jarvis:password@localhost:5432/jarvis"
#REDIS_URL="redis://localhost:6379/0"
#JWT_SECRET="generate-a-long-random-value-at-least-32-chars"
#JARVIS_ENCRYPTION_KEY="generate-a-separate-long-random-value-32-chars"
#CORS_ORIGINS="http://localhost:3000"
#JARVIS_ENV="development"
# Set to "1" for any real deployment (Docker/Fly/Render already do this).
# Flags this process as the hosted multi-tenant API so memory_manager
# refuses to fall back to the local single-user memory file.
#JARVIS_HOSTED="0"
#AUTO_CREATE_TABLES="1"
# Production requires this to be "1" (validate_production() enforces it):
# an in-memory rate-limit fallback only protects a single process, so with
# more than one API instance it stops being a real limit.
#REDIS_REQUIRED="0"
# Access tokens are short-lived by design; a stolen token is also revocable
# server-side at any time via /auth/logout, /auth/logout-all, or
# DELETE /auth/sessions/{id} (see api/sessions.py).
#ACCESS_TOKEN_MINUTES="60"
#JARVIS_CHAT_MODEL="gemini-3.6-flash"
# How long chat/task/answer-cache history is kept before the periodic
# retention job purges it (see api/server.py's _retention_loop).
#JARVIS_RETENTION_DAYS="90"
# Session cookie transport. "lax" works for same-site setups (including
# localhost across ports); use "none" (with HTTPS) when the web frontend
# and API are on different registrable domains.
#SESSION_COOKIE_NAME="jarvis_session"
#SESSION_COOKIE_SAMESITE="lax"
#SESSION_COOKIE_DOMAIN=""
#SESSION_COOKIE_SECURE="0"

